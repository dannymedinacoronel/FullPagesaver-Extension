{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "FullPage Saver",
  "description": "__MSG_extDesc__",
  "default_locale": "es",
  "version": "2.9.7",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "downloads",
    "pageCapture",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "save-pdf": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "__MSG_cmdSavePdf__"
    }
  }
}
